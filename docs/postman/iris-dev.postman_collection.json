{
  "info": {
    "name": "iris-dev serving",
    "description": "Smoke-test iris-species-dev after the approved v6 deploy. Fill databricks_token at runtime from local .env / Key Vault — never commit a value. Live run waits on that deploy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{databricks_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "score-setosa",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const rows = Array.isArray(body) ? body : (body.predictions || []);",
              "const row = rows[0];",
              "pm.test(\"species is setosa and both layman strings are present\", function () {",
              "  pm.expect(row.prediction.species).to.eql(\"setosa\");",
              "  pm.expect(row.shap.layman).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(row.feature_importance.layman).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dataframe_records\": [\n    {\n      \"sepal_length_cm\": 5.1,\n      \"sepal_width_cm\": 3.5,\n      \"petal_length_cm\": 1.4,\n      \"petal_width_cm\": 0.2\n    }\n  ]\n}"
        },
        "url": "{{endpoint_url}}/invocations"
      }
    },
    {
      "name": "score-virginica",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const rows = Array.isArray(body) ? body : (body.predictions || []);",
              "const row = rows[0];",
              "pm.test(\"species is virginica and both layman strings are present\", function () {",
              "  pm.expect(row.prediction.species).to.eql(\"virginica\");",
              "  pm.expect(row.shap.layman).to.be.a(\"string\").and.not.empty;",
              "  pm.expect(row.feature_importance.layman).to.be.a(\"string\").and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dataframe_records\": [\n    {\n      \"sepal_length_cm\": 6.3,\n      \"sepal_width_cm\": 2.9,\n      \"petal_length_cm\": 5.6,\n      \"petal_width_cm\": 1.8\n    }\n  ]\n}"
        },
        "url": "{{endpoint_url}}/invocations"
      }
    }
  ]
}
